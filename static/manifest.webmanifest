{
  "name": "Pocketwise",
  "short_name": "Pocketwise",
  "description": "Private local expense, budget and debt manager.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#08131f",
  "theme_color": "#08131f",
  "icons": [
    {
      "src": "/static/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/static/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Add expense",
      "short_name": "Expense",
      "url": "/transactions?add_kind=expense#add"
    },
    {
      "name": "Add income",
      "short_name": "Income",
      "url": "/transactions?add_kind=income#add"
    },
    {
      "name": "Pay debt",
      "short_name": "Debts",
      "url": "/debts"
    }
  ]
}